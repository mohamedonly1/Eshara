# بيانات حساسة ومجلدات المستخدمين
.env
users_data/
languages_data/settings.json
users_keys.txt
deleted_accounts_with_data.txt

# ملفات البيانات الكبيرة والمجمعة (CSVs)
languages_data/**/*.csv
*.csv

# السماح برفع داتا سيت اللغة العربية
!languages_data/ar/ar_keypoints.csv
!languages_data/ar/ar_labels.csv

# صور الحسابات المرفوعة من المستخدمين
static/uploads/

# ملفات السجلات والتقارير
logs/
*.log
reports/

# ملفات Python المؤقتة والبيئة الافتراضية
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env.local

# ملفات النماذج والأوزان (كبيرة — لا ترفع للجيت)
arabic_model/*.h5
arabic_model/*.keras
*.h5
*.keras

# نسمح برفع نماذج TFLite الخفيفة الخاصة بالاستنتاج
!arabic_model/*.tflite

# ملفات النظام المؤقتة
.DS_Store
Thumbs.db

# ملفات الضغط والملفات المكتبية المؤقتة
*.zip
*.tar.gz
*.rar
*.docx
*.pdf

# بناء أندرويد وملفات Gradle
Ishara/

# تجاهل جميع ملفات الـ APK والملفات التنفيذية
*.apk
ngrok.exe
*.exe

scratch/
test_keypoints.py
