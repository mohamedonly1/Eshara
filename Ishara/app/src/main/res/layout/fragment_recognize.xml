<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Camera preview — fullscreen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Hand landmark overlay — stacked on top of preview, same size -->
    <com.ishara.app.HandOverlayView
        android:id="@+id/handOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- TOP overlay: letter pill + confidence -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="top|start"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/currentLetterPill"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="ـ"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#a7f3d0"
            android:background="@drawable/letter_pill_bg" />

        <TextView
            android:id="@+id/confidenceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="14sp"
            android:textColor="@color/text_dim"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- TOP-END: Switch camera button -->
    <ImageButton
        android:id="@+id/switchCameraButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_switch_camera"
        android:background="@drawable/switch_camera_bg"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="تبديل الكاميرا" />

    <!-- BOTTOM overlay container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_gravity="bottom"
        android:paddingBottom="16dp"
        android:background="@android:color/transparent">

        <!-- Confirmed text output -->
        <TextView
            android:id="@+id/confirmedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textDirection="rtl"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/confirmed_text_bg"
            android:padding="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="12dp"
            android:maxLines="3"
            android:ellipsize="start" />

        <!-- Clear button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear"
            android:textColor="@color/bg_dark"
            android:backgroundTint="@color/accent"
            app:cornerRadius="999dp" />
    </LinearLayout>

</FrameLayout>
